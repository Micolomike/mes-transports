<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MesTransports" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/fond</item>
        <item name="android:colorBackground">@color/fond</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/fond</item>
        <item name="android:navigationBarColor">@color/fond</item>
    </style>

    <style name="Carte">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/carte</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/encre</item>
    </style>

    <style name="Titre">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">26dp</item>
        <item name="android:textColor">@color/encre</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Aide">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/encre_pale</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Bouton">
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bouton</item>
        <item name="android:textColor">@color/encre</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="WidgetSens">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:textColor">@color/encre_pale</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WidgetDeparts">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/encre</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
