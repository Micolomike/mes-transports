<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/point"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/point" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/encre"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            style="@style/Carte"
            android:id="@+id/apercu"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="2dp"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/actualiser"
                style="@style/Bouton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Actualiser" />

            <Button
                android:id="@+id/epingler"
                style="@style/Bouton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Ajouter le widget" />
        </LinearLayout>

        <TextView
            style="@style/Titre"
            android:text="Jeton PRIM (Île-de-France Mobilités)" />

        <TextView
            style="@style/Aide"
            android:text="Le même que celui du connecteur sur le PC (fichier Documents\\TransportsIDF\\config.json, champ apikey). Il reste stocké sur le téléphone uniquement." />

        <EditText
            android:id="@+id/jeton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Jeton PRIM"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true"
            android:textColor="@color/encre"
            android:textColorHint="@color/encre_pale" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/coller"
                style="@style/Bouton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Coller" />

            <Button
                android:id="@+id/enregistrer"
                style="@style/Bouton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Enregistrer" />
        </LinearLayout>

        <TextView
            style="@style/Titre"
            android:text="Mises à jour automatiques" />

        <Switch
            android:id="@+id/plages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Seulement aux heures de trajet"
            android:textColor="@color/encre"
            android:textSize="16sp" />

        <TextView
            style="@style/Aide"
            android:text="Toutes les 15 minutes (minimum imposé par Android), du lundi au vendredi de 6h00 à 9h15 et de 16h00 à 18h15. Désactivé : toutes les 15 minutes en permanence. Le bouton ↻ du widget actualise à tout moment." />

        <Button
            android:id="@+id/batterie"
            style="@style/Bouton"
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:text="Exclure l'appli de l'optimisation de batterie" />

        <TextView
            style="@style/Aide"
            android:text="Sur Samsung, sans cette exclusion, One UI peut retarder ou bloquer les mises à jour en arrière-plan." />
    </LinearLayout>
</ScrollView>
